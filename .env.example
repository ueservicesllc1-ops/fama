# ==============================================================================
# FAMA — Plantilla Oficial de Variables de Entorno (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CLIENT SDK (Públicas en el navegador)
# Proyecto oficial: fama-db35d
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=tu_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=fama-db35d.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fama-db35d
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=fama-db35d.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=tu_app_id

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN SDK (Privadas de servidor, NUNCA usar prefijo NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=fama-db35d
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@fama-db35d.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_clave_privada_aqui\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. BACKBLAZE B2 STORAGE (Almacenamiento de Video & Grabaciones)
# Bucket oficial: famaweb
# Endpoint S3: s3.us-east-005.backblazeb2.com
# ------------------------------------------------------------------------------
B2_APPLICATION_KEY_ID=tu_b2_application_key_id
B2_APPLICATION_KEY=tu_b2_application_key_secret
B2_BUCKET_NAME=famaweb
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# ------------------------------------------------------------------------------
# 4. PROVEEDOR DE TRANSMISIÓN EN DIRECTO (STREAMING)
# Opciones soportadas: cloudflare_stream | mux | generic_rtmp_hls | none
# ------------------------------------------------------------------------------
STREAMING_PROVIDER=none

# Opción A: Cloudflare Stream Live
# Contratar en: https://dash.cloudflare.com/ (Cloudflare Stream)
# Permisos: Stream:Edit, Account:Read
CLOUDFLARE_ACCOUNT_ID=tu_cloudflare_account_id
CLOUDFLARE_STREAM_API_TOKEN=tu_cloudflare_stream_api_token

# Opción B: Mux Video Live Streams
# Contratar en: https://dashboard.mux.com/ (Settings > Access Tokens)
# Permisos: Mux Video (Full Access)
MUX_TOKEN_ID=tu_mux_token_id
MUX_TOKEN_SECRET=tu_mux_token_secret

# Opción C: Servidor RTMP / HLS Propio (Nginx RTMP, SRS, Wowza)
GENERIC_STREAM_RTMP_URL=rtmp://tu-servidor-streaming/live
GENERIC_STREAM_KEY=clave_de_emision
GENERIC_STREAM_HLS_URL=https://tu-servidor-streaming/hls/live.m3u8

# ------------------------------------------------------------------------------
# 5. WEBHOOK DE STREAMING (Notificaciones y Grabación Automática)
# URL a registrar en el proveedor: https://tu-dominio.com/api/streaming/webhook
# ------------------------------------------------------------------------------
STREAMING_WEBHOOK_SECRET=tu_secreto_para_validar_firmas_webhook

# ------------------------------------------------------------------------------
# 5b. SEGURIDAD DEL WEBHOOK
# STREAMING_WEBHOOK_SECRET es OBLIGATORIO en produccion (el webhook responde 503 sin el).
# Opcional: lista de dominios permitidos para descargar grabaciones (separados por comas).
# ------------------------------------------------------------------------------
STREAMING_ALLOWED_DOWNLOAD_HOSTS=

# ------------------------------------------------------------------------------
# 6. CORREO (Gmail con Contrasena de Aplicacion)
# ------------------------------------------------------------------------------
GMAIL_USER=tu_cuenta@gmail.com
GMAIL_APP_PASSWORD=tu_contrasena_de_aplicacion
CONTACT_NOTIFICATION_EMAIL=

# ------------------------------------------------------------------------------
# 7. NOTIFICACIONES PUSH (Web Push / VAPID) Y URL PUBLICA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu_vapid_public_key
VAPID_PRIVATE_KEY=tu_vapid_private_key
VAPID_SUBJECT=mailto:tu_correo@dominio.com
NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# ------------------------------------------------------------------------------
# 8. DESARROLLO LOCAL (NUNCA activar en produccion)
# Permite el acceso admin simulado (headers x-dev-*) SOLO si Firebase Admin no esta
# configurado y NODE_ENV != production. Por defecto, sin Admin SDK se deniega el acceso.
# ------------------------------------------------------------------------------
# ALLOW_DEV_AUTH=true
